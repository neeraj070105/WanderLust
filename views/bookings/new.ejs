<% layout("/layouts/boilerplate") %>

<div class="container mt-5" style="max-width:600px;">
  <h3 class="mb-4">Book this listing :</h3>

  <!-- IMPORTANT: form ko id diya hai -->
  <form method="POST" action="/listings/<%= listingId %>/book" id="bookingForm">

    <div class="mb-3">
      <label class="form-label">Check In</label>
      <input 
        type="date" 
        name="checkIn" 
        id="checkIn"
        min="<%= new Date().toISOString().split('T')[0] %>"
        class="form-control"
        required
      >
    </div>

    <div class="mb-3">
      <label class="form-label">Check Out</label>
      <input 
        type="date" 
        name="checkOut"
        id="checkOut" 
        min="<%= new Date().toISOString().split('T')[0] %>"
        class="form-control"
        required
      >
    </div>

    <div class="mb-3">
      <label class="form-label">Total Price</label>
      <input 
        type="text" 
        id="totalPrice"
        class="form-control"
        value="₹ <%= listing.price.toLocaleString('en-IN') %>"
        disabled
      >
    </div>

    <!-- Hidden fields -->
    <input type="hidden" name="paymentMethod" id="paymentMethod">
    <input type="hidden" name="paymentStatus" id="paymentStatus">
    <input type="hidden" name="paymentId" id="paymentId">
    <input type="hidden" name="pricePerNight" value="<%= listing.price %>">

    <button 
      type="button"
      id="bookBtn"
      class="btn w-100 mt-3"
      style="
        background-color:#fe424d;
        color:white;
        border:none;
        padding:12px;
        font-size:16px;
        border-radius:30px;
      "
    >
      BOOK NOW
    </button>

  </form>
</div>

<!-- Razorpay -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
window.onload = function () {

  const form = document.getElementById("bookingForm");
  const btn = document.getElementById("bookBtn");

  const pricePerNight = Number("<%= listing.price %>");
  const checkInInput = document.getElementById("checkIn");
  const checkOutInput = document.getElementById("checkOut");
  const totalPriceInput = document.getElementById("totalPrice");

  // Price Calculate
  function calculatePrice() {
    if (!checkInInput.value || !checkOutInput.value) {
      totalPriceInput.value = "₹ 0";
      return;
    }

    const checkInDate = new Date(checkInInput.value);
    const checkOutDate = new Date(checkOutInput.value);

    if (checkOutDate <= checkInDate) {
      totalPriceInput.value = "₹ 0";
      return;
    }

    const days = (checkOutDate - checkInDate) / (1000 * 60 * 60 * 24);
    const total = days * pricePerNight;

    totalPriceInput.value = `₹ ${total.toLocaleString("en-IN")}`;
  }

  checkInInput.addEventListener("change", calculatePrice);
  checkOutInput.addEventListener("change", calculatePrice);

  // Current total nikalne ke liye
  function getCurrentTotal() {
    const text = totalPriceInput.value;
    return Number(text.replace(/[₹,\s]/g, ""));
  }

  // Button click
  btn.addEventListener("click", function () {

    const choice = confirm(
      "OK = Pay Online\nCancel = Pay Later"
    );

    // Pay Online
    if (choice) {

      fetch("/listings/create-order", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          amount: getCurrentTotal()
        })
      })
      .then(res => res.json())
      .then(order => {

        const options = {
          key: "<%= razorpayKeyId %>",
          amount: order.amount,
          currency: "INR",
          name: "Wanderlust",
          description: "Booking Payment",
          order_id: order.id,

          handler: function (response) {

            document.getElementById("paymentMethod").value = "Razorpay";
            document.getElementById("paymentStatus").value = "Paid";
            document.getElementById("paymentId").value =
              response.razorpay_payment_id;

            form.submit();   // IMPORTANT FIX
          }
        };

        const rzp = new Razorpay(options);
        rzp.open();

      });

    }

    // Pay Later
    else {

      document.getElementById("paymentMethod").value = "Pay Later";
      document.getElementById("paymentStatus").value = "Pending";

      form.submit();   // IMPORTANT FIX
    }

  });

};
</script>